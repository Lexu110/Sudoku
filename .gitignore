!.vscode/launch.json

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.exe

# Packaged releases (Tools/make-deb.sh output, archives) and Unity's debug-symbols folders
*.deb
*.tar.gz
*.zip
/[Rr]eleases/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Crash and profiler output
sysinfo.txt
*.stackdump
crashlytics-build.properties

# Addressables / generated
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db
Desktop.ini
